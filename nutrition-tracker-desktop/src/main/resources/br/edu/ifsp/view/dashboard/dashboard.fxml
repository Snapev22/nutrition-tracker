<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  TASK-16 - Dashboard (SHOULD HAVE).
  - cbAlunoDashboard / dpDataDashboard / btnAtualizarDashboard: seleção
    de aluno + data (data padrão = hoje, definido no controller) e
    botão para recarregar os dados.
  - lblMetaDashboard / lblConsumidoDashboard / lblRestanteDashboard:
    labels grandes com os valores do plano do dia.
  - progressBarConsumo: valor de 0.0 a 1.0 representando
    consumido / meta. O controller pode trocar a styleClass
    (progress-ok / progress-alerta / progress-excedido, definidas em
    common.css) conforme o percentual: verde até 80%, amarelo até 100%,
    vermelho acima de 100%.
  - lblPercentual: texto do tipo "72% da meta utilizada".
-->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.edu.ifsp.controller.DashboardController"
      spacing="25.0" alignment="TOP_CENTER" >
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER">
        <Label text="Aluno:"/>
        <ComboBox fx:id="cbAlunoDashboard" prefWidth="220.0"/>
        <Label text="Data:"/>
        <DatePicker fx:id="dpDataDashboard"/>
        <Button fx:id="btnAtualizarDashboard" text="Atualizar" styleClass="botao-primario" onAction="#onAtualizarDashboard"/>
    </HBox>

    <VBox spacing="10.0" alignment="CENTER" styleClass="info-box">
        <Label fx:id="lblMetaDashboard" text="Meta diária: -- kcal" styleClass="info-label"/>
        <Label fx:id="lblConsumidoDashboard" text="Planejado: -- kcal" styleClass="info-label"/>
        <Label fx:id="lblRestanteDashboard" text="Restante: -- kcal" styleClass="info-label"/>
    </VBox>

    <HBox spacing="20.0" alignment="CENTER">
        <Label fx:id="lblProteinaDashboard" text="Proteína: -- g" styleClass="resumo-label"/>
        <Label fx:id="lblCarboidratoDashboard" text="Carboidrato: -- g" styleClass="resumo-label"/>
        <Label fx:id="lblGorduraDashboard" text="Gordura: -- g" styleClass="resumo-label"/>
    </HBox>

    <VBox spacing="8.0" alignment="CENTER" maxWidth="500.0">
        <ProgressBar fx:id="progressBarConsumo" progress="0.0" prefWidth="400.0" prefHeight="20.0"/>
        <Label fx:id="lblPercentual" text="0% da meta utilizada"/>
    </VBox>
</VBox>
