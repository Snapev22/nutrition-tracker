<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  TASK-15 - Tela de Plano Diário.
  - cbAluno: lista todos os alunos cadastrados (precisa de conversor visual
    para mostrar o nome do Aluno, não o objeto cru).
  - dpData: padrão = hoje (definido no controller).
  - btnCarregarPlano: busca ou cria o plano do dia (aluno + data).
  - lblMeta / lblConsumido / lblRestante: atualizados sempre que um item
    é adicionado ou removido.
  - cbAlimento: lista todos os alimentos cadastrados (também precisa de
    conversor visual para mostrar o nome).
  - btnAdicionarItem: ao exceder a meta, o controller captura
    LimiteCaloricoExcedidoException e exibe um Alert (WARNING) com a
    mensagem da exception - não há nada especial a fazer aqui na FXML,
    mas o fluxo deve ser tratado no controller.
  - colAlimentoNome: exibe ItemPlano.alimento.nome (cellValueFactory
    customizado no controller, pois é um atributo de objeto aninhado).
-->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.edu.ifsp.controller.PlanoController"
      spacing="15.0">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <!-- Seleção de Aluno e Data -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Aluno:"/>
        <ComboBox fx:id="cbAluno" prefWidth="220.0"/>
        <Label text="Data:"/>
        <DatePicker fx:id="dpData"/>
        <Button fx:id="btnCarregarPlano" text="Carregar Plano" styleClass="botao-primario" onAction="#onCarregarPlano"/>
    </HBox>

    <!-- Resumo -->
    <HBox spacing="30.0" alignment="CENTER_LEFT" styleClass="resumo-box">
        <Label fx:id="lblMeta" text="Meta: -- kcal" styleClass="resumo-label"/>
        <Label fx:id="lblPlanejado" text="Planejado: -- kcal" styleClass="resumo-label"/>
        <Label fx:id="lblRestante" text="Restante: -- kcal" styleClass="resumo-label"/>
        <Label fx:id="lblProteina" text="Proteína: -- g" styleClass="resumo-label"/>
        <Label fx:id="lblCarboidrato" text="Carboidrato: -- g" styleClass="resumo-label"/>
        <Label fx:id="lblGordura" text="Gordura: -- g" styleClass="resumo-label"/>
    </HBox>


    <!-- Adição de item -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Alimento:"/>
        <ComboBox fx:id="cbAlimento" prefWidth="200.0"/>
        <Label text="Quantidade:"/>
        <TextField fx:id="tfQuantidade" prefWidth="80.0"/>
        <Button fx:id="btnAdicionarItem" text="Adicionar" styleClass="botao-primario" onAction="#onAdicionarItem"/>
    </HBox>

    <!-- Tabela de itens do plano -->
    <Label text="Itens do Plano" styleClass="titulo"/>

    <TableView fx:id="tableItens" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAlimentoNome" text="Alimento" prefWidth="220.0"/>
            <TableColumn fx:id="colQuantidade" text="Quantidade" prefWidth="120.0"/>
            <TableColumn fx:id="colCaloriasTotais" text="Calorias" prefWidth="140.0"/>
            <TableColumn fx:id="colProteina" text="Proteína (g)" prefWidth="100.0"/>
            <TableColumn fx:id="colCarboidrato" text="Carboidrato (g)" prefWidth="110.0"/>
            <TableColumn fx:id="colGordura" text="Gordura (g)" prefWidth="100.0"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnRemoverItem" text="Remover Item Selecionado" styleClass="botao-perigo" onAction="#onRemoverItem"/>
    </HBox>
</VBox>
