<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  TASK-14 - Tela de Alunos.
  - Mesmo padrão da tela de Alimentos: formulário (esquerda) + tabela (centro).
  - cbSexo, cbFatorAtividade e cbObjetivo recebem os itens dos respectivos
    enums (Sexo.values(), FatorAtividade.values(), Objetivo.values()) e um
    StringConverter/cell factory amigável - feito no controller.
  - lblMetaCalorica é apenas exibição (não editável), atualizada após "Salvar".
-->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ifsp.controller.AlunoController"
            stylesheets="@../common.css">
    <left>
        <VBox spacing="10.0" prefWidth="300.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <Label text="Cadastro de Aluno" styleClass="titulo"/>

            <GridPane hgap="10.0" vgap="10.0">
                <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Idade:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="tfIdade" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Peso (kg):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="tfPeso" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Altura (cm):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="tfAltura" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Sexo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbSexo" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="180.0"/>

                <Label text="Fator de Atividade:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbFatorAtividade" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="180.0"/>

                <Label text="Objetivo:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbObjetivo" GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="180.0"/>
            </GridPane>

            <Label fx:id="lblMetaCaloricaEstimada" text="Meta Estimada (TMB): -- kcal" styleClass="meta-calorica"/>
            <TextField fx:id="tfMetaCaloricaDefinida" promptText="Meta definida (kcal) — em branco usa a estimativa"/>

            <HBox spacing="10.0">
                <Button fx:id="btnSalvar" text="Salvar" styleClass="botao-primario" onAction="#onSalvar"/>
                <Button fx:id="btnLimpar" text="Limpar" onAction="#onLimpar"/>
                <Button fx:id="btnExcluir" text="Excluir" styleClass="botao-perigo" onAction="#onExcluir"/>
            </HBox>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="0.0"/>
            </padding>

            <Label text="Alunos Cadastrados" styleClass="titulo"/>

            <TableView fx:id="tableAlunos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="140.0"/>
                    <TableColumn fx:id="colIdade" text="Idade" prefWidth="60.0"/>
                    <TableColumn fx:id="colPeso" text="Peso" prefWidth="70.0"/>
                    <TableColumn fx:id="colAltura" text="Altura" prefWidth="70.0"/>
                    <TableColumn fx:id="colSexo" text="Sexo" prefWidth="90.0"/>
                    <TableColumn fx:id="colObjetivo" text="Objetivo" prefWidth="110.0"/>
                    <TableColumn fx:id="colMetaCaloricaEstimada" text="Meta Estimada (TMB)" prefWidth="130.0"/>
                    <TableColumn fx:id="colMetaDefinida" text="Meta Definida" prefWidth="110.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
